{
  "name": "sdf-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Build 3D shapes from signed distance functions in your browser: node graph, real-time ray marching, watertight mesh export.",
  "author": "Vin's Atelier",
  "license": "MIT",
  "type": "module",
  "homepage": "https://vincentwesley.github.io/sdf-forge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincentwesley/sdf-forge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "meshes": "tsx scripts/export-meshes.ts artifacts/meshes && python3 scripts/validate_meshes.py artifacts/meshes && node scripts/validate-gltf.mjs artifacts/meshes",
    "serve": "node scripts/serve-dist.mjs",
    "thumbnails": "tsx scripts/thumbnails.ts",
    "acceptance": "node scripts/acceptance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xyflow/react": "^13.0.2",
    "lucide-react": "^1.74.0",
    "manifold-3d": "^3.5.5",
    "mediabunny": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
